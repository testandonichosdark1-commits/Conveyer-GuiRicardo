# All keys can also be set through the UI at /settings.
# Anything here is used as a fallback when the corresponding DB row is empty.

# ── Required ──────────────────────────────────────────────
# Gemini for scene splitting. Get one free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# 69labs.vip — covers Grok img2vid + images. Starts with vk_
LABS69_API_KEY=

# HeyGen — TTS voice generation. https://app.heygen.com/settings/api
HEYGEN_API_KEY=

# ── Optional / backup providers ───────────────────────────
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=

# ── Google Flow browser provider (experimental) ───────────
# Select AI_PROVIDER=flow_browser in Settings. The first login is completed manually
# in the persistent Chrome window; later image generations are automated.
AI_PROVIDER=
FLOW_PROJECT_URL=https://labs.google/fx/tools/flow
FLOW_BROWSER_PROFILE_DIR=
FLOW_BROWSER_CHANNEL=chrome
FLOW_BROWSER_EXECUTABLE=
FLOW_BROWSER_HEADLESS=0
FLOW_CDP_PORT=9223
FLOW_GENERATION_TIMEOUT_SEC=240
FLOW_FALLBACK_PROVIDER=none
FLOW_IMAGE_MODEL=nano-banana-pro
FLOW_ASPECT_RATIO=16:9
FLOW_REGEN_ATTEMPTS=1

# Absolute path to ffmpeg if it isn't already in your PATH.
# Windows example: C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=

# ── Storage location ──────────────────────────────────────
# Where runs are written. Leave empty to use the default (~/.conveyer-grok/runs).
# Setting this also recreates the data/runs junction inside the project.
CONVEYER_GROK_DATA_DIR=
