# All keys can also be set through the UI at /settings.
# Anything here is used as a fallback when the corresponding DB row is empty.

# ── Required ──────────────────────────────────────────────
# Gemini for scene splitting. Get one free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# 69labs.vip — covers Grok img2vid + images. Starts with vk_
LABS69_API_KEY=

# HeyGen — TTS voice generation. https://app.heygen.com/settings/api
HEYGEN_API_KEY=

# ── Optional / backup providers ───────────────────────────
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=

# Absolute path to ffmpeg if it isn't already in your PATH.
# Windows example: C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=

# ── Auth (Supabase) ───────────────────────────────────────
# Gates the whole app behind a login. Create a project at https://supabase.com,
# then Settings → API for these two values. Users are created manually in the
# dashboard (Authentication → Users); there is no public signup. Give an admin
# user app_metadata = { "role": "admin" } to unlock Settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Storage location ──────────────────────────────────────
# Where runs are written. Leave empty to use the default (~/.conveyer-grok/runs).
# Setting this also recreates the data/runs junction inside the project.
CONVEYER_GROK_DATA_DIR=
