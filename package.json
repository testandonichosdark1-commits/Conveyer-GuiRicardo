{
  "name": "faceless-video-generator",
  "version": "0.4.2",
  "private": true,
  "description": "Local pipeline platform for avatar-fronted documentary YouTube videos — HeyGen photo avatar + ElevenLabs voiceover, illustrated with real internet footage / AI b-roll (Ken Burns on stills).",
  "scripts": {
    "predev": "node scripts/wigolo.mjs ensure",
    "dev": "next dev",
    "wigolo:stop": "node scripts/wigolo.mjs stop",
    "build": "next build",
    "prestart": "node scripts/wigolo.mjs ensure",
    "start": "next start",
    "test": "vitest run",
    "resume:studio": "tsx scripts/resume-studio.ts",
    "wigolo:queries": "tsx scripts/wigolo-plan-queries.ts",
    "wigolo:bakeoff": "tsx scripts/wigolo-bakeoff.ts",
    "postinstall": "node scripts/fix-native-binaries.mjs",
    "fix-bins": "node scripts/fix-native-binaries.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^171.4.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "wigolo": "^0.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fastembed": {
      "tar": "^7.5.22"
    }
  }
}
